# AI chat backend base URL (optional separate service; used by MapPage's AI panel)
VITE_API_BASE_URL=http://localhost:8000

# Mapbox public token (pk.ey...) — required for map rendering and geocoding
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# GIWA Sepolia address that receives x402 report payments (the oracle's wallet)
VITE_RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000

# Deployed contract addresses (optional) — enables "view on GIWA Explorer" links
# across the app. Leave blank until togibox-scraper / togibox-api are deployed.
VITE_ORACLE_CONTRACT_ADDRESS=
VITE_RECEIPT_CONTRACT_ADDRESS=
